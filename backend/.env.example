# ─────────────────────────────────────────────────────────────
#  HAPPY BODY CLINIC & SPA — Variables de entorno
#  Copia este archivo a .env y llena los valores reales
#  NUNCA subas .env a GitHub
# ─────────────────────────────────────────────────────────────

# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://USUARIO:PASSWORD@cluster0.XXXXX.mongodb.net/happybody?retryWrites=true&w=majority

# Puerto del servidor (Railway lo asigna automáticamente)
PORT=3001

# Ambiente: development | production
NODE_ENV=development

# URL del frontend (para CORS)
# En desarrollo: http://localhost:5500
# En producción: https://happybodyclinicandspa.netlify.app
FRONTEND_URL=https://happybodyclinicandspa.netlify.app

# Clave secreta para ejecutar el seed desde la API
# Genera una clave larga y difícil: ej. HappyBodySeed2026!XyZ
SEED_KEY=CAMBIAR_POR_CLAVE_SEGURA
